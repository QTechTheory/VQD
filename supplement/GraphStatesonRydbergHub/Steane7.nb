        SubscriptBox["Z", "5"]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xlogic", "=", 
     RowBox[{
      SubscriptBox["X", "0"], 
      SubscriptBox["X", "1"], 
      SubscriptBox["X", "3"]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zlogic", "=", 
     RowBox[{
      SubscriptBox["Z", "0"], 
      SubscriptBox["Z", "1"], 
      SubscriptBox["Z", "3"]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "\[IndentingNewLine]", 
    RowBox[{
    "returns", " ", "indices", " ", "of", " ", "the", " ", "involved", " ", 
     "stabilizers"}], " ", "\[IndentingNewLine]", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stabindex", "[", "stab_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Level", "[", 
      RowBox[{"stab", ",", "1"}], "]"}], "/.", 
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"_", ",", "j_"}], "]"}], ":>", "j"}]}]}], " ", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", 
    RowBox[{
