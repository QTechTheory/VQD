Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nshots", "=", "1000"}], ";"}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<=", 
    RowBox[{"Length", "@", "options"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"opt", "=", 
     RowBox[{"options", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "  ", 
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Trial \>\"", ",", "i", ",", " ", "\"\<: \>\"", ",", " ", "opt"}], 
     "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"res", "=", 
     RowBox[{"SimulateSteane", "[", 
      RowBox[{
      "\[Rho]", ",", "\[Rho]init", ",", "\[Rho]work", ",", "\[Rho]store", ",",
        "nshots", ",", 
       RowBox[{"{", 
        RowBox[{"steane", ",", "lsteane"}], "}"}], ",", "opt"}], "]"}]}], ";",
     "\[IndentingNewLine]", "  ", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"steane7", ",", " ", "res"}], "]"}], ";", "\n", "  ", 
    RowBox[{"DumpSave", "[", 
     RowBox[{"\"\<steane7.mx\>\"", ",", " ", "steane7"}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"out", "=", 
     RowBox[{"Values", "@", 
      RowBox[{
       RowBox[{"steaneResults", "[", 
        RowBox[{"res", ",", "steane", ",", "lsteane"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"\"\<benchmarkstab\>\"", ",", "\"\<benchmarklogic\>\""}], 
         "}"}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "@", "out"}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "if", " ", "the", " ", "all", " ", "true", " ", "one", " ", "is", " ", 
       "found"}], ",", " ", "break"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"And", "@@", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Flatten", "@", 
          RowBox[{"Values", "@", 
           RowBox[{"out", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
         RowBox[{"Values", "@", 
          RowBox[{"out", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ",", 
      RowBox[{"Break", "[", "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
