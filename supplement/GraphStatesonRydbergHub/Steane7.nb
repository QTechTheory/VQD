Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"noisycirc", "=", 
    RowBox[{"InsertCircuitNoise", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
       "circ0", ",", "circ1", ",", "circ2", ",", "circ3", ",", "circ4"}], 
