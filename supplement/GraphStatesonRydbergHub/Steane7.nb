 RowBox[{
  RowBox[{"nshots", "=", "10000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<=", 
     RowBox[{"Length", "@", "options"}]}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"opt", "=", 
      RowBox[{"options", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Trial \>\"", ",", "i", ",", " ", "\"\<: \>\"", ",", " ", "opt"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"SimulateSteane", "[", 
       RowBox[{
       "\[Rho]", ",", "\[Rho]init", ",", "\[Rho]work", ",", "\[Rho]store", 
        ",", "nshots", ",", 
        RowBox[{"{", 
         RowBox[{"steane", ",", "lsteane"}], "}"}], ",", "opt"}], "]"}]}], 
     ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"steane7", ",", " ", "res"}], "]"}], ";", "\n", "  ", 
     RowBox[{"DumpSave", "[", 
      RowBox[{"\"\<steane7.mx\>\"", ",", " ", "steane7"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"out", "=", 
      RowBox[{"Values", "@", 
       RowBox[{
        RowBox[{"steaneResults", "[", 
         RowBox[{"res", ",", "steane", ",", "lsteane"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"{", 
          RowBox[{
          "\"\<chart\>\"", ",", "\"\<benchmarkstab\>\"", ",", 
