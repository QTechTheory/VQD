      RowBox[{"stabilizer_result", ",", " ", "logical_result"}], "}"}]}], " ",
     "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SimulateSteane", "[", 
     RowBox[{
     "\[Rho]_", ",", "\[Rho]init_", ",", "\[Rho]work_", ",", "\[Rho]store_", 
      ",", "nshots_", ",", "expres_", ",", 
      RowBox[{"options_", ":", 
       RowBox[{"{", "}"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
