Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FormatHamiltonian", "::", "usage"}], "=", 
    "\"\<Format the hamiltonian from qiskit to questlink\>\""}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"FormatHamiltonian", "[", "filename_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"stringham", ",", "ham", ",", "nterms", ",", "nqubits"}], "}"}], 
    "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"stringham", " ", "=", " ", 
      RowBox[{"Import", "[", "filename", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"ham", " ", "=", " ", 
      RowBox[{"ToExpression", "[", "stringham", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nqubits", " ", "=", " ", 
      RowBox[{
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Level", "[", 
              RowBox[{"#", ",", " ", 
               RowBox[{"-", "1"}]}], "]"}], "&"}], " ", "/@", 
            RowBox[{"Flatten", " ", "@", " ", "ham"}]}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{"NumericQ", "[", "#", "]"}], "&"}]}], "]"}]}], "//", 
       "Max"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ham", "=", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "term", "]"}], " ", "<", " ", "2"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"term", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            SubscriptBox["Id", 
             RowBox[{"nqubits", "-", "1"}]]}], "}"}], ",", " ", "term"}], 
         "]"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"term", ",", " ", "ham"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nterms", " ", "=", " ", 
      RowBox[{"Length", " ", "@", " ", "ham"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Total", " ", "@", " ", 
        RowBox[{"Apply", "[", 
         RowBox[{"Times", ",", " ", "ham", ",", " ", "1"}], "]"}]}], ",", " ",
        "nterms", ",", " ", "nqubits"}], "}"}]}]}], "\n", "]"}]}]}], "Input",
 CellChangeTimes->{
  3.8916027764797707`*^9, {3.89160284912342*^9, 
   3.8916030319654493`*^9}},ExpressionUUID->"70b9e930-2792-4c93-b2d2-\
3fb19c9d1cef"],

