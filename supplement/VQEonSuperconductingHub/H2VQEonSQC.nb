      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<distance\>\"", "->", "distance"}], ",", 
        RowBox[{"\"\<hamiltonian\>\"", "->", "hamiltonian"}], ",", 
        RowBox[{"\"\<runtime\>\"", " ", "->", " ", "runtime"}], ",", " ", 
        RowBox[{"\"\<ansatz\>\"", " ", "->", " ", "ansatz"}], ",", " ", 
        RowBox[{"\"\<\[Theta]vars\>\"", " ", "->", " ", "\[Theta]vars"}], ",",
