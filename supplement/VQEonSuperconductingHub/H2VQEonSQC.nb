Cell[BoxData[
 RowBox[{
  RowBox[{"angleToMinusPiToPi", "[", "angle_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{"angle", "+", "\[Pi]"}], ",", 
     RowBox[{"2", " ", "\[Pi]"}]}], "]"}], "-", "\[Pi]"}]}]], "Input",
