Cell[BoxData[
 RowBox[{"Table", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "distance", ",", "hamiltonian", ",", "runtime", ",", "ansatz", ",", 
       "\[Theta]vars", ",", "groundstate", ",", "cost", ",", "fev"}], "}"}], 
     "=", 
     RowBox[{"Values", "@", "res"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ansatz", "=", 
     RowBox[{
      RowBox[{"DeleteCases", "[", 
       RowBox[{"ansatz", ",", 
        RowBox[{
         SubscriptBox["Depol", "_"], "[", "_", "]"}]}], "]"}], "/.", 
      RowBox[{"angleToMinusPiToPi", " ", "@", " ", "\[Theta]vars"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"nansatz", "=", 
     RowBox[{"ExtractCircuit", "@", 
      RowBox[{"InsertCircuitNoise", "[", 
       RowBox[{"ansatz", ",", 
        RowBox[{"SuperconductingHub", "[", "]"}], ",", 
        RowBox[{"ReplaceAliases", "->", "True"}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ApplyCircuit", "[", 
     RowBox[{
      RowBox[{"InitZeroState", "@", "\[Rho]6"}], ",", "nansatz"}], "]"}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"MatrixForm", "@", 
     RowBox[{"Chop", "@", 
      RowBox[{"PartialTrace", "[", 
       RowBox[{"\[Rho]6", ",", "0", ",", "1", ",", "2", ",", "3"}], 
       "]"}]}]}]}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"res", ",", "vqeH21"}], "}"}]}], "]"}]], "Input",
