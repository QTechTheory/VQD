Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "distance", ",", "hamiltonian", ",", "runtime", ",", "ansatz", ",", 
       "\[Theta]vars", ",", "groundstate", ",", "cost", ",", "fev"}], "}"}], 
     "=", 
     RowBox[{"Values", "@", "res"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"nansatz", "=", 
     RowBox[{"ExtractCircuit", "@", 
      RowBox[{"InsertCircuitNoise", "[", 
       RowBox[{"ansatz", ",", 
        RowBox[{"SuperconductingHub", "[", 
         RowBox[{"StdPassiveNoise", "->", "False"}], "]"}], ",", 
        RowBox[{"ReplaceAliases", "->", "True"}]}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ApplyCircuit", "[", 
     RowBox[{
      RowBox[{"InitZeroState", "@", "\[Rho]6"}], ",", 
      RowBox[{"nansatz", "/.", "\[Theta]vars"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"MatrixForm", "@", 
     RowBox[{"Chop", "@", 
      RowBox[{"PartialTrace", "[", 
       RowBox[{"\[Rho]6", ",", "0", ",", "1", ",", "2", ",", "3"}], 
       "]"}]}]}]}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"res", ",", "vqeH22"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.8871091277240667`*^9, 3.887109164200506*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"5d238ab7-b30a-4f87-86eb-4e9604aa0bd7"],

