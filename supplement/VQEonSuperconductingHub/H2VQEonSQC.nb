Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"trial3", "=", 
   RowBox[{"Table", "[", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"fname", "=", 
       RowBox[{"ToString", "@", 
        RowBox[{"StringForm", "[", 
         RowBox[{"\"\<H2_hamiltonians/H2_``.txt\>\"", ",", " ", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"distance", ",", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}]}]}], ";", 
      "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"hamiltonian", ",", " ", "nterms", ",", " ", "nq"}], "}"}], 
       " ", "=", " ", 
       RowBox[{"FormatHamiltonian", "[", "fname", "]"}]}], ";", "\n", " ", 
      RowBox[{"dev", " ", "=", " ", 
       RowBox[{"SuperconductingHub", "[", 
        RowBox[{
         RowBox[{"StdPassiveNoise", "->", "False"}], ",", " ", 
         RowBox[{"ZZPassiveNoise", "->", "False"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"groundstate", "=", 
       RowBox[{"Min", "@", 
        RowBox[{"Eigenvalues", "@", 
         RowBox[{"CalcPauliStringMatrix", "@", "hamiltonian"}]}]}]}], ";", 
      "\n", " ", 
      RowBox[{"conf", " ", "=", " ", 
       RowBox[{"DefaultConfig", "[", 
        RowBox[{"dev", ",", " ", "hamiltonian"}], "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"conf", "[", "\"\<virtualmeas\>\"", "]"}], "=", 
       RowBox[{"{", "}"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"conf", "[", "\"\<initcirc\>\"", "]"}], "=", 
       RowBox[{"{", "}"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"conf", "[", "\"\<groundstate\>\"", "]"}], " ", "=", " ", 
       "groundstate"}], ";", "\n", "    ", 
      RowBox[{"res", " ", "=", " ", 
       RowBox[{"VQEonVQD", "[", "conf", "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "runtime", ",", " ", "cost", ",", " ", "Elist", ",", " ", "ansatz", 
         ",", " ", "\[Theta]vars", ",", " ", "finmsg", ",", " ", "ncycle", 
         ",", " ", "fev", ",", " ", "aborted", ",", " ", "cycleres", ",", " ",
          "elimmerge", ",", " ", "elimbfsmall", ",", " ", "elimmetov", ",", 
         " ", "elimbf"}], "}"}], " ", "=", " ", "res"}], ";", "\n", 
      RowBox[{"res", "=", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<distance\>\"", "->", "distance"}], ",", 
         RowBox[{"\"\<hamiltonian\>\"", "->", "hamiltonian"}], ",", 
         RowBox[{"\"\<runtime\>\"", " ", "->", " ", "runtime"}], ",", " ", 
         RowBox[{"\"\<ansatz\>\"", " ", "->", " ", "ansatz"}], ",", " ", 
         RowBox[{"\"\<\[Theta]vars\>\"", " ", "->", " ", "\[Theta]vars"}], 
         ",", " ", 
         RowBox[{"\"\<groundstate\>\"", " ", "->", " ", "groundstate"}], ",", 
         " ", 
         RowBox[{"\"\<cost\>\"", " ", "->", " ", "cost"}], ",", " ", 
         RowBox[{"\"\<fev\>\"", " ", "->", " ", "fev"}]}], "|>"}]}], ";", 
      "\n", " ", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<dist \>\"", ",", " ", "distance", ",", " ", "\"\< ; runtime \>\"",
         ",", " ", "runtime", ",", " ", "\"\< ; \[Epsilon]=\>\"", ",", " ", 
        RowBox[{
         RowBox[{"Last", "@", "Elist"}], " ", "-", " ", 
         RowBox[{"conf", "[", "\"\<groundstate\>\"", "]"}]}]}], "]"}], ";", 
      "\n", 
      RowBox[{"Print", "@", 
       RowBox[{"ListPlot", "[", 
        RowBox[{"Elist", ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "300"}], ",", 
         RowBox[{"PlotMarkers", "->", 
          RowBox[{"{", "\"\<OpenMarkers\>\"", "}"}]}], ",", 
         RowBox[{"Joined", "->", "True"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<iteration\>\"", ",", "\"\<<E>\>\""}], "}"}]}]}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"DrawCircuit", "[", 
         RowBox[{
          RowBox[{"ansatz", "/.", "CustomGatesDraw"}], ",", " ", "6"}], "]"}],
         ",", 
        RowBox[{"ansatz", "/.", "\[Theta]vars"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "res"}], "\n", " ", ",", " ", 
     RowBox[{"{", 
      RowBox[{"distance", ",", 
       RowBox[{"{", 
        RowBox[{"0.77", ",", "2.40"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
